# Copy this file to .env and provide local values. Never commit .env.
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000

JOBTECH_BASE_URL=https://jobsearch.api.jobtechdev.se
JOBTECH_TIMEOUT_SECONDS=20
JOBTECH_API_KEY=

# PostgreSQL runs in the project Compose service on host port 5433.
POSTGRES_DB=ai_job_assistant
POSTGRES_USER=ai_job_assistant
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_PORT=5433
DATABASE_URL=postgresql+asyncpg://ai_job_assistant:replace-with-a-local-password@localhost:5433/ai_job_assistant

# Added when the AI phase begins.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_EMBEDDING_MODEL=

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
